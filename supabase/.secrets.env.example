# Copy to supabase/.secrets.env and fill in values (never commit .secrets.env)
RESEND_API_KEY=re_your_key_here
# REQUIRED for multi-user delivery: an address on a domain you verified in Resend.
# onboarding@resend.dev is sandbox-only and can only reach the Resend account owner (e.g. Favio).
EMAIL_FROM_ADDRESS=notifications@your-verified-domain.com
EMAIL_FROM_NAME=Arbol Momentum
APP_BASE_URL=https://fcosorio123.github.io/ArbolMomentum
# Shared with GitHub Actions secret CRON_SECRET for scheduled email nudges
CRON_SECRET=generate_a_long_random_string_here
# Optional: AI-assisted goal/task creation. Without LLM_API_KEY the edge uses rules.
LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_key_here
LLM_MODEL=gpt-4o-mini
# Also set the same EMAIL_FROM_ADDRESS in GitHub Actions secrets before deploy.
