{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:pages": "vite build && node scripts/prepare-pages-dist.mjs",
    "build:figma": "vite build && node scripts/prepare-figma-dist.mjs",
    "pack:figma-sync": "git archive --format=zip --output=figma-sync-from-github.zip HEAD",
    "backup:running": "node scripts/update-running-backup.mjs",
    "dev": "vite",
    "deploy:edge": "powershell -ExecutionPolicy Bypass -File scripts/deploy-email.ps1",
    "test:pre-c6": "node scripts/verify-pre-c6.mjs",
    "test:c7": "node scripts/test-c7-gate.mjs",
    "test:c8": "node scripts/verify-c8-go-live.mjs",
    "test:post-push": "node scripts/verify-post-push.mjs",
    "test:ai-assist": "npx tsx scripts/test-ai-assist-contracts.ts && node scripts/test-ai-assist-persist.mjs",
    "test:onboarding": "npx tsx scripts/test-product-onboarding.ts",
    "test:simplify-detail": "npx tsx scripts/test-simplify-detail-assist.ts",
    "test:email-schedule": "npx tsx scripts/test-email-schedule-time.ts",
    "test:task-focus": "npx tsx scripts/test-task-focus-selection.ts",
    "test:seed-deletion": "npx tsx scripts/test-seed-deletion-tombstones.ts",
    "test:today-hierarchy": "npx tsx scripts/test-today-hierarchy-order.ts",
    "test:feedback-interest": "npx tsx scripts/test-feedback-interest.ts",
    "test:task-progress": "npx tsx scripts/test-task-progress-pipeline.ts",
    "test:task-demotion": "npx tsx scripts/test-task-status-demotion.ts",
    "test:profile-roster": "npx tsx scripts/test-profile-roster.ts",
    "test:momentum-starter": "npx tsx scripts/test-momentum-starter-seed.ts",
    "backfill:momentum-starter": "node scripts/backfill-momentum-starter-seed.mjs",
    "test:surgical-ux": "npm run test:seed-deletion && npm run test:today-hierarchy && npm run test:feedback-interest && npm run test:task-focus",
    "test:progress-pipeline": "npm run test:task-progress && npm run test:task-demotion && npm run test:task-focus"
  },
